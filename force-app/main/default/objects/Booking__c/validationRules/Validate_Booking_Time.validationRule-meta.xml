<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validate_Booking_Time</fullName>
    <active>true</active>
    <errorConditionFormula>Booking_End__c &lt;= Booking_Start__c</errorConditionFormula>
    <errorDisplayField>Booking_End__c</errorDisplayField>
    <errorMessage>Booking End must be later than Booking Start.</errorMessage>
</ValidationRule>
